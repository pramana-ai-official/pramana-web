# The pre-registration form emails each entry through a mailbox on the team's own domain.
# Set these on the host (Vercel: Project > Settings > Environment Variables). Never commit
# real values: the real .env files are ignored by git.

# The mailbox that sends the mail. It must be a real mailbox on the mail server below.
SMTP_USER=team@pramanaai.in
# That mailbox's password.
SMTP_PASS=

# Optional. The defaults are Hostinger's mail server and the team's address.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# REGISTER_TO=team@pramanaai.in
